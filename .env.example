# Local Compose bootstrap only; do not use these demo credentials in production.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway_db
LOCAL_API_KEY=test-api-key-1

# Running the JAR directly: explicitly use SPRING_PROFILES_ACTIVE=local for demos.
# Production is the default profile and requires DB_PASSWORD and existing non-demo keys.
# Direct-JAR infrastructure properties:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gateway_db
# DB_USERNAME=gateway
# DB_PASSWORD=<unique password>
# Local profile updates the seeded provider URL from this property:
# OLLAMA_BASE_URL=http://localhost:11434
