# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway_db

# ── Gateway Database Connection ──────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gateway_db
DB_USERNAME=gateway
DB_PASSWORD=gateway

# ── Ollama ───────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434

# ── Test API Key (plaintext) ─────────────────────────
# The seeded API key hash in the database corresponds to this plaintext value.
# Use this in the X-API-Key header when testing locally.
TEST_API_KEY=test-api-key-1

# ── Notes ────────────────────────────────────────────
# 1. Copy this file to .env before running: cp .env.example .env
# 2. After first `docker compose up`, pull the Ollama model:
#    docker exec ollama ollama pull qwen3
